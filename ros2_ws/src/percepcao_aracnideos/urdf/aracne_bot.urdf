<?xml version="1.0"?>
<!--
  ARACNE — URDF do robo de inspecao de aracnideos.

  Plataforma diferencial com mastro de camera. O mastro existe por uma
  razao do dominio: aracnideos sao encontrados no solo, em vegetacao
  baixa e em paredes, e uma camera na altura do chassi so enxerga o
  primeiro caso. O mastro coloca o sensor a 0,42 m com inclinacao para
  baixo, cobrindo os tres.

  Convencao de eixos (REP-103): x para frente, y para a esquerda,
  z para cima. Cores e inercias sao aproximacoes razoaveis — o objetivo
  aqui e um modelo cinematicamente coerente para RViz2 e, no TP3, para
  o Gazebo, nao um gemeo digital fiel.
-->
<robot name="aracne_bot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ============ materiais ============ -->
  <material name="cinza_escuro"><color rgba="0.25 0.27 0.30 1.0"/></material>
  <material name="laranja">     <color rgba="0.90 0.49 0.13 1.0"/></material>
  <material name="preto">       <color rgba="0.10 0.10 0.10 1.0"/></material>
  <material name="azul">        <color rgba="0.12 0.45 0.72 1.0"/></material>
  <material name="verde">       <color rgba="0.20 0.65 0.35 1.0"/></material>
  <material name="vermelho">    <color rgba="0.80 0.15 0.15 1.0"/></material>

  <!-- ============ base ============ -->
  <!-- base_footprint e a projecao do robo no chao. E dela que a
       navegacao do TP4 parte; separa-la do chassi agora evita ter de
       reescrever a arvore TF depois. -->
  <link name="base_footprint"/>

  <joint name="base_footprint_para_base_link" type="fixed">
    <parent link="base_footprint"/>
    <child  link="base_link"/>
    <origin xyz="0 0 0.055" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry><box size="0.34 0.24 0.06"/></geometry>
      <material name="cinza_escuro"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry><box size="0.34 0.24 0.06"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.03"/>
      <mass value="3.2"/>
      <inertia ixx="0.01632" ixy="0.0" ixz="0.0"
               iyy="0.0318" iyz="0.0" izz="0.04619"/>
    </inertial>
  </link>

  <!-- ============ rodas motrizes ============ -->
  <joint name="roda_esquerda_joint" type="continuous">
    <parent link="base_link"/>
    <child  link="roda_esquerda_link"/>
    <origin xyz="0 0.135 0.0" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.02" friction="0.01"/>
  </joint>

  <link name="roda_esquerda_link">
    <visual>
      <geometry><cylinder radius="0.055" length="0.026"/></geometry>
      <material name="preto"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.055" length="0.026"/></geometry>
    </collision>
    <inertial>
      <mass value="0.25"/>
      <inertia ixx="0.000203" ixy="0.0" ixz="0.0"
               iyy="0.000203" iyz="0.0" izz="0.000378"/>
    </inertial>
  </link>

  <joint name="roda_direita_joint" type="continuous">
    <parent link="base_link"/>
    <child  link="roda_direita_link"/>
    <origin xyz="0 -0.135 0.0" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.02" friction="0.01"/>
  </joint>

  <link name="roda_direita_link">
    <visual>
      <geometry><cylinder radius="0.055" length="0.026"/></geometry>
      <material name="preto"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.055" length="0.026"/></geometry>
    </collision>
    <inertial>
      <mass value="0.25"/>
      <inertia ixx="0.000203" ixy="0.0" ixz="0.0"
               iyy="0.000203" iyz="0.0" izz="0.000378"/>
    </inertial>
  </link>

  <!-- ============ roda boba ============ -->
  <joint name="roda_boba_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="roda_boba_link"/>
    <origin xyz="-0.13 0 -0.03" rpy="0 0 0"/>
  </joint>

  <link name="roda_boba_link">
    <visual>
      <geometry><sphere radius="0.025"/></geometry>
      <material name="preto"/>
    </visual>
    <collision><geometry><sphere radius="0.025"/></geometry></collision>
    <inertial>
      <mass value="0.06"/>
      <inertia ixx="1.5e-5" ixy="0.0" ixz="0.0"
               iyy="1.5e-5" iyz="0.0" izz="1.5e-5"/>
    </inertial>
  </link>

  <!-- ============ mastro da camera ============ -->
  <joint name="mastro_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="mastro_link"/>
    <origin xyz="0.08 0 0.06" rpy="0 0 0"/>
  </joint>

  <link name="mastro_link">
    <visual>
      <origin xyz="0 0 0.15"/>
      <geometry><cylinder radius="0.018" length="0.30"/></geometry>
      <material name="laranja"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.15"/>
      <geometry><cylinder radius="0.018" length="0.30"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.15"/>
      <mass value="0.30"/>
      <inertia ixx="0.00229" ixy="0.0" ixz="0.0"
               iyy="0.00229" iyz="0.0" izz="0.0000486"/>
    </inertial>
  </link>

  <!-- Junta revoluta: a camera pode inclinar. E por ela que a acao de
       varredura do TP3 vai varrer verticalmente. Limitada para nao
       colidir com o proprio chassi. -->
  <joint name="camera_tilt_joint" type="revolute">
    <parent link="mastro_link"/>
    <child  link="camera_base_link"/>
    <origin xyz="0 0 0.30" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.6109" upper="0.3491" effort="2.0" velocity="1.0"/>
    <dynamics damping="0.05"/>
  </joint>

  <link name="camera_base_link">
    <visual>
      <geometry><box size="0.045 0.075 0.035"/></geometry>
      <material name="azul"/>
    </visual>
    <collision><geometry><box size="0.045 0.075 0.035"/></geometry></collision>
    <inertial>
      <mass value="0.12"/>
      <inertia ixx="0.0000685" ixy="0.0" ixz="0.0"
               iyy="0.0000325" iyz="0.0" izz="0.0000765"/>
    </inertial>
  </link>

  <!-- camera_link: o frame do sensor. O frame_id publicado pelo
       camera_node e este. -->
  <joint name="camera_joint" type="fixed">
    <parent link="camera_base_link"/>
    <child  link="camera_link"/>
    <origin xyz="0.023 0 0" rpy="0 0.1745 0"/>
  </joint>

  <link name="camera_link">
    <visual>
      <geometry><cylinder radius="0.012" length="0.012"/></geometry>
      <origin rpy="0 1.5708 0"/>
      <material name="preto"/>
    </visual>
  </link>

  <!-- Frame optico: z para frente, x para a direita, y para baixo.
       E a convencao que sensor_msgs/Image assume. Misturar este frame
       com o mecanico e a causa mais comum de nuvem de pontos espelhada
       ou girada 90 graus no RViz. -->
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child  link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>
  <link name="camera_optical_frame"/>

  <!-- ============ LiDAR simulado ============ -->
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="lidar_link"/>
    <origin xyz="-0.06 0 0.075" rpy="0 0 0"/>
  </joint>

  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="0.035" length="0.04"/></geometry>
      <material name="verde"/>
    </visual>
    <collision><geometry><cylinder radius="0.035" length="0.04"/></geometry></collision>
    <inertial>
      <mass value="0.16"/>
      <inertia ixx="0.0000703" ixy="0.0" ixz="0.0"
               iyy="0.0000703" iyz="0.0" izz="0.000098"/>
    </inertial>
  </link>

  <!-- ============ IMU simulada ============ -->
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="imu_link"/>
    <origin xyz="0 0 0.062" rpy="0 0 0"/>
  </joint>

  <link name="imu_link">
    <visual>
      <geometry><box size="0.022 0.022 0.006"/></geometry>
      <material name="vermelho"/>
    </visual>
    <inertial>
      <mass value="0.02"/>
      <inertia ixx="8.7e-7" ixy="0.0" ixz="0.0"
               iyy="8.7e-7" iyz="0.0" izz="1.6e-6"/>
    </inertial>
  </link>

  <!-- ==================================================================
       Plugins de sensor do Gazebo.
       Ignorados pelo RViz2 e pelo robot_state_publisher; so passam a
       valer quando o modelo for carregado no Gazebo, no TP3. Estao aqui
       desde ja para que a migracao seja "spawnar o mesmo URDF", e nao
       reescrever o modelo.
       ================================================================== -->

  <gazebo reference="camera_link">
    <sensor name="camera_aracne" type="camera">
      <always_on>true</always_on>
      <update_rate>15.0</update_rate>
      <visualize>true</visualize>
      <camera>
        <horizontal_fov>1.0472</horizontal_fov>
        <image><width>640</width><height>480</height><format>R8G8B8</format></image>
        <clip><near>0.03</near><far>12.0</far></clip>
        <noise><type>gaussian</type><mean>0.0</mean><stddev>0.007</stddev></noise>
      </camera>
      <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
        <ros><namespace>/</namespace>
             <remapping>~/image_raw:=/camera/image_raw</remapping>
             <remapping>~/camera_info:=/camera/camera_info</remapping></ros>
        <frame_name>camera_optical_frame</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo reference="lidar_link">
    <sensor name="lidar_aracne" type="ray">
      <always_on>true</always_on>
      <update_rate>10.0</update_rate>
      <visualize>true</visualize>
      <ray>
        <scan><horizontal>
          <samples>360</samples><resolution>1.0</resolution>
          <min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle>
        </horizontal></scan>
        <range><min>0.12</min><max>8.0</max><resolution>0.015</resolution></range>
        <noise><type>gaussian</type><mean>0.0</mean><stddev>0.01</stddev></noise>
      </ray>
      <plugin name="lidar_controller" filename="libgazebo_ros_ray_sensor.so">
        <ros><remapping>~/out:=/scan</remapping></ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>lidar_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo reference="imu_link">
    <sensor name="imu_aracne" type="imu">
      <always_on>true</always_on>
      <update_rate>50.0</update_rate>
      <plugin name="imu_controller" filename="libgazebo_ros_imu_sensor.so">
        <ros><remapping>~/out:=/imu/data</remapping></ros>
        <frame_name>imu_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo>
    <plugin name="tracao_diferencial" filename="libgazebo_ros_diff_drive.so">
      <ros><remapping>cmd_vel:=/cmd_vel</remapping>
           <remapping>odom:=/odom</remapping></ros>
      <left_joint>roda_esquerda_joint</left_joint>
      <right_joint>roda_direita_joint</right_joint>
      <wheel_separation>0.27</wheel_separation>
      <wheel_diameter>0.11</wheel_diameter>
      <max_wheel_torque>6.0</max_wheel_torque>
      <max_wheel_acceleration>1.2</max_wheel_acceleration>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>true</publish_wheel_tf>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
    </plugin>
  </gazebo>

  <gazebo reference="base_link"><material>Gazebo/DarkGrey</material></gazebo>
  <gazebo reference="mastro_link"><material>Gazebo/Orange</material></gazebo>
  <gazebo reference="lidar_link"><material>Gazebo/Green</material></gazebo>
  <gazebo reference="roda_esquerda_link"><material>Gazebo/Black</material></gazebo>
  <gazebo reference="roda_direita_link"><material>Gazebo/Black</material></gazebo>

</robot>
