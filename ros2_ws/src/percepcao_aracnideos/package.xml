<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>percepcao_aracnideos</name>
  <version>0.2.0</version>
  <description>ARACNE - percepcao de aracnideos por camera com ROS 2: deteccao YOLO, rastreamento com filtro de Kalman, acao de varredura e URDF do robo.</description>
  <maintainer email="euejaojaoeeu@gmail.com">João Rafael Broz dos Santos</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>cv_bridge</depend>
  <depend>rcl_interfaces</depend>
  <depend>percepcao_aracnideos_interfaces</depend>

  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
